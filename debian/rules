#!/usr/bin/make -f

export DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

BUILD_STATIC_DIR=$(CURDIR)/build-static/
BUILD_SHARED_DIR=$(CURDIR)/build-shared/
SOURCE_VERSION=$(shell dpkg-parsechangelog -S Version)

%:
	dh $@ --buildsystem=cmake

# Use host-built code generators when cross-compiling.
COMMON_BUILD_FLAGS= \
        -DCMAKE_TOOLCHAIN_FILE=$(CURDIR)/debian/cross-toolchain.cmake \
		-DgRPC_INSTALL=ON \
		-DgRPC_PROTOBUF_PROVIDER=module \
		-DgRPC_SSL_PROVIDER=package \
		-DgRPC_ZLIB_PROVIDER=module \
		-DgRPC_GFLAGS_PROVIDER=module \
		-DCMAKE_BUILD_TYPE=Release \
		-DgRPC_RE2_PROVIDER=module \
		-DgRPC_ABSL_PROVIDER=module \
		-DABSL_PROPAGATE_CXX_STD=ON \
		-DgRPC_CARES_PROVIDER=module \
        -DgRPC_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH) \
        -DgRPC_INSTALL_CMAKEDIR=lib/$(DEB_HOST_MULTIARCH)/cmake/grpc \
		-DgRPC_INSTALL_PKGCONFIG_DIR=lib/$(DEB_HOST_MULTIARCH)/pkgconfig \
        -DProtobuf_PROTOC_EXECUTABLE=/home/seanboyden/grpc-1.59.3/build-host/protoc \
		-D_gRPC_PROTOBUF_PROTOC_EXECUTABLE=/home/seanboyden/grpc-1.59.3/build-host/protoc \
        -D_gRPC_CPP_PLUGIN=/home/seanboyden/grpc-1.59.3/build-host/grpc_cpp_plugin

override_dh_auto_clean:
	$(RM) -r $(BUILD_STATIC_DIR)
	dh_auto_clean -O--buildsystem=cmake -O--builddir=$(BUILD_SHARED_DIR)
	$(RM) $(CURDIR)/a.out

override_dh_auto_configure:
	dh_auto_configure -O--buildsystem=cmake \
		-O--builddir=$(BUILD_STATIC_DIR) -- \
		-DBUILD_SHARED_LIBS=OFF \
		-DgRPC_BUILD_TESTS=OFF \
		$(COMMON_BUILD_FLAGS)
	dh_auto_configure -O--buildsystem=cmake \
		-O--builddir=$(BUILD_SHARED_DIR) -- \
		-DBUILD_SHARED_LIBS=ON \
		-DgRPC_BUILD_TESTS=OFF \
		$(COMMON_BUILD_FLAGS)

override_dh_auto_build:
	dh_auto_build -O--buildsystem=cmake \
		-O--builddir=$(BUILD_STATIC_DIR)
	dh_auto_build -O--buildsystem=cmake \
		-O--builddir=$(BUILD_SHARED_DIR)

override_dh_auto_install:
	dh_auto_install -O--buildsystem=cmake \
		-O--builddir=$(BUILD_STATIC_DIR)
	dh_auto_install -O--buildsystem=cmake \
		-O--builddir=$(BUILD_SHARED_DIR)

# this disables tests that shared invokes;  take too long
override_dh_auto_test:

# Point shlibdeps at module-built dependencies and assign bundled Abseil its own package.
override_dh_shlibdeps:
	mkdir -p $(CURDIR)/debian/so-libs
	find build-shared -name "*.so*" -exec cp -f {} $(CURDIR)/debian/so-libs \;

	rm -f $(CURDIR)/debian/shlibs.local
	echo "libgcc_s 1 libgcc-s1" >> $(CURDIR)/debian/shlibs.local
	for library_file in $(CURDIR)/debian/so-libs/*.so*; do \
		soname=$$(basename "$$library_file" | sed 's/\.so\..*//'); \
		library_version=$$(basename "$$library_file" | sed 's/.*\.so\.//'); \
		package_name=libgrpc; \
		case "$$soname" in libabsl_*) package_name=libabsl20230802t64 ;; esac; \
		echo "$$soname $$library_version $$package_name (>= $(SOURCE_VERSION))" >> $(CURDIR)/debian/shlibs.local; \
	done

	dh_shlibdeps -- -l$(CURDIR)/debian/so-libs -l/usr/$(DEB_HOST_MULTIARCH)/lib

